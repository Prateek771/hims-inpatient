{
  "name": "hims-inpatient-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "node scripts/vitest.mjs run --project unit",
    "test:integration": "node scripts/vitest.mjs run --project integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --experimental-strip-types scripts/migrate-cli.ts",
    "billing:room-worker": "node scripts/room-worker.mjs",
    "test:e2e": "node scripts/playwright.mjs test",
    "test:install": "node scripts/playwright.mjs install chromium",
    "check": "npm run test:unit && npm run test:integration && npm run lint && npm run typecheck && npm run build && npm run test:e2e",
    "auth:bootstrap": "node scripts/bootstrap-admin.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@langchain/core": "1.2.17",
    "@langchain/langgraph": "1.4.21",
    "@langchain/langgraph-checkpoint-postgres": "1.0.6",
    "@react-pdf/renderer": "4.9.0",
    "better-auth": "1.7.7",
    "bwip-js": "4.11.4",
    "drizzle-orm": "0.45.4",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
