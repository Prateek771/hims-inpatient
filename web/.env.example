# Copy values from your explicit local HIMS setup only, never another project.
# On Windows, scripts/setup-local-database.ps1 creates new local databases and
# writes generated credentials into ignored web/.env.local without saving the
# PostgreSQL administrator password. It refuses existing targets/files.
# Runtime and migration accounts must differ; none is a PostgreSQL superuser.
DATABASE_URL=
MIGRATION_DATABASE_URL=
# Both test URLs must point to the separate synthetic hims_test database.
# Test fixtures may reset that database's HIMS schema; never use hospital data.
TEST_DATABASE_URL=
TEST_RUNTIME_DATABASE_URL=
# Random local session-signing key, generated by setup. Never commit its value.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
