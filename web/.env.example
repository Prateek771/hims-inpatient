# MariaDB branch (codex/mariadb-port). Copy values from your explicit local setup only, never another project.
# On Windows, scripts/setup-local-mariadb.ps1 creates the local databases and accounts and writes generated
# credentials into the ignored web/.env.mariadb.local without saving the MariaDB administrator password.
# On Hostinger set the same names as Node.js environment variables (hPanel or `hostinger hosting nodejs`), with the
# database host `localhost` as given by Hostinger for apps running on the same plan.
DATABASE_URL=mysql://user:password@127.0.0.1:3306/hims_local
# With one database user (hosting) this is the same URL as DATABASE_URL.
MIGRATION_DATABASE_URL=mysql://user:password@127.0.0.1:3306/hims_local
# Both test URLs must point to the separate synthetic hims_test database (owner and limited runtime account).
# Test fixtures reset that database; never use hospital data.
TEST_DATABASE_URL=
TEST_RUNTIME_DATABASE_URL=
# Random session-signing key (at least 32 characters). Never commit its value.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Protects POST /api/cron/room-charges, which a hosting cron job calls to reconcile room charges.
HIMS_CRON_SECRET=
